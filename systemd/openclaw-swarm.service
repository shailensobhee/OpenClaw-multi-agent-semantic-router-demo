[Unit]
Description=OpenClaw Sovereign Swarm booth demo (:7000)
After=network.target

[Service]
WorkingDirectory=/opt/openclaw-swarm
Environment=PORT=7000
Environment=VLLM_URL=http://127.0.0.1:8000
Environment=VLLM_CONTAINER=vllm
ExecStart=/opt/openclaw-swarm/.venv/bin/python backend.py
Restart=always

[Install]
WantedBy=multi-user.target
