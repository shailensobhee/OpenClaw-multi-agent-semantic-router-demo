[Unit]
Description=OpenClaw REAL agent swarm orchestrator
After=network.target

[Service]
WorkingDirectory=/opt/openclaw-swarm
Environment=VLLM_API_KEY=local-vllm
Environment=SWARM_MODEL=vllm/Qwen2.5-7B-Instruct
Environment=SWARM_STATE=/opt/openclaw-swarm/state.json
Environment=SWARM_CONCURRENCY=8
Environment=HOME=/root
ExecStart=/opt/openclaw-swarm/.venv/bin/python swarm.py
Restart=always

[Install]
WantedBy=multi-user.target
